# Example Caddy site blocks for both Sadr3D products on the same OVH VPS.
# Inspect the live /etc/caddy/Caddyfile first (alpha may still be bound to the
# bare IP). Merge these host blocks, then:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# DNS (registrar):
#   sadr3d.com          A     51.75.124.117   # apex → VPS (leave parking IP and redirect breaks)
#   www.sadr3d.com      A     51.75.124.117   # optional; same redirect block
#   horizon.sadr3d.com     A     51.75.124.117
#   sphere.sadr3d.com      A     51.75.124.117
#   analytics.sadr3d.com   A     51.75.124.117   # Umami (docs/UMAMI.md)
#   (optional) AAAA → 2001:41d0:305:2100::1:9b44
#
# Horizon API: production web build should set VITE_API_URL to the public API
# origin (same host via reverse_proxy, or https://horizon.sadr3d.com if you
# proxy / to the API paths the front already calls). Adjust to match the
# existing alpha Caddyfile — do not blindly replace a working IP site.
#
# Cache policy (Sphere only — do not copy these headers onto Horizon blindly):
#   index.html     → no-cache (always revalidate → fresh hashed bundles)
#   /assets/*      → immutable year (Vite content hashes in filenames)
#   sky/models/…   → 1 day + must-revalidate (fixed URLs, rarely change)
#   COG            → 30 days (replaced rarely; Range requests still work)

# Temporary apex / www → Sphere until a real sadr3d.com home exists.
# Preserve path + query; permanent (301) so browsers / Search Console cache it.
sadr3d.com, www.sadr3d.com {
	redir https://sphere.sadr3d.com{uri} permanent
}

horizon.sadr3d.com {
	encode gzip zstd

	# Prefer mirroring whatever reverse_proxy rules already work on the IP site.
	handle /health {
		reverse_proxy 127.0.0.1:3000
	}
	handle /access/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /visibility* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /moon* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /spots* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /var/www/photo-sightline
		try_files {path} /index.html
		file_server
	}
}

# Umami dashboard + collect API (loopback Docker → :3100). See docs/UMAMI.md.
analytics.sadr3d.com {
	encode gzip zstd

	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy 127.0.0.1:3100
}

sphere.sadr3d.com {
	encode gzip zstd

	# App security headers (Sphere SPA + MapLibre/Three/WebGL/COG workers).
	# connect-src / img-src stay on https: — tile / weather / geocode hosts vary.
	# script-src allows first-party Umami on analytics.sadr3d.com (docs/UMAMI.md).
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://analytics.sadr3d.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: blob:; worker-src 'self' blob:; child-src 'self' blob:; media-src 'self' blob:"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Persistent VIIRS COG (~64 Mo) — outside the rsync --delete web root.
	# URL matches app default: /light-pollution/viirs-vnl-2024-500m.cog.tif
	# Caddy file_server supports Range → 206 Partial Content.
	handle /light-pollution/* {
		root * /home/ubuntu/sadr3d-sphere/data
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Vite hashed JS/CSS/workers — no SPA fallback (missing hash → real 404).
	handle /assets/* {
		root * /var/www/sadr3d-sphere
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /var/www/sadr3d-sphere

		@html path / /index.html
		header @html Cache-Control "no-cache"

		@static path /sky/* /models/* /vendor/* /catalogs/* /favicon.svg /icons.svg /robots.txt /sitemap.xml /og-share.png
		header @static Cache-Control "public, max-age=86400, must-revalidate"

		# SPA fallback for unknown paths (no client router today; keep for later).
		try_files {path} /index.html
		file_server
	}
}
